# ==============================================================================
# BUSBUDDY SERVER - KONFIGURASI DATABASE PostgreSQL (.env)
# ==============================================================================

# OPSI A: KONEKSI LOKAL POSTGRESQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=busbuddy_db

# OPSI B: CLOUD POSTGRESQL (Supabase / Neon / Railway / Render)
# Cukup isi DATABASE_URL, opsi A akan diabaikan jika DATABASE_URL diisi:
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Port server API (default: 3000)
SERVER_PORT=3000

# Izinkan request dari origin frontend ini (ubah jika deploy ke server lain)
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,null
