# ==============================================================================
# BUSBUDDY SERVER - KONFIGURASI DATABASE (Salin file ini menjadi .env)
# ==============================================================================
# Ganti nilai di bawah sesuai dengan pengaturan MySQL lokal Anda

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=busbuddy_db

# Port server API (default: 3000)
SERVER_PORT=3000

# Izinkan request dari origin frontend ini (ubah jika deploy ke server lain)
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,null
